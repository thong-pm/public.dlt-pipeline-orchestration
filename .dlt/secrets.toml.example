[sources.hubspot]
api_key = "<configure_me>"

[sources.shopify]
api_password = "<configure_me>"
shop_url = "https://<your-shop-name>.myshopify.com"

[sources.xero]
client_id = "<configure_me>"
client_secret = "<configure_me>"
access_token = "<configure_me>"
tenant_id = "<configure_me>"

[sources.procore]
active_env = "sandbox"

[sources.procore.sandbox]
client_id = "<configure_me>"
client_secret = "<configure_me>"
access_token = "<configure_me>"
refresh_token = "<configure_me>"

[sources.procore.prod]
client_id = "<configure_me>"
client_secret = "<configure_me>"
access_token = "<configure_me>"
refresh_token = "<configure_me>"

[destination.postgres.credentials]
database = "postgres"
password = "<configure_me>"
username = "<configure_me>"
host = "localhost"
port = 5432

# ── BigQuery (Cloud) ─────────────────────────────────────
[destination.bigquery.credentials]
project_id = "<your-gcp-project-id>"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "<your-service-account-email>"
location = "US"

[slack]
webhook_url = "<configure_me>"

# ── GCP Deployment Configuration ───────────────────────────
[gcp]
project_id = "<your-gcp-project-id>"
region = "us-central1"
token_bucket = "<your-gcs-bucket-for-tokens>"
cloud_run_job = "dlt-pipeline-job"
# Optional: path to gcloud binary if not in standard PATH
# gcloud_bin = "/path/to/gcloud"